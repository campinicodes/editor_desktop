{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://plataforma-zoneamento.local/schema/cidade.schema.json",
 "title": "Cidade – parâmetros urbanísticos normalizados (plataforma multicidades STAR/Tenda)",
 "description": "Fonte de verdade do formato <slug>.json (schema_versao 1.2; 1.1 continua aceito). Ver PADRAO_JSON.md e schema/README.md.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_versao",
  "municipio",
  "uf",
  "slug",
  "codigo_ibge",
  "data_levantamento",
  "centro_mapa",
  "marco_legal_vigente",
  "fontes",
  "macrozonas",
  "zonas",
  "camadas_complementares",
  "outorga_onerosa",
  "zeis_his",
  "outros_parametros",
  "resumo_mcmv",
  "geografico",
  "lacunas"
 ],
 "properties": {
  "schema_versao": {
   "enum": [
    "1.1",
    "1.2"
   ],
   "description": "1.2 acrescenta os blocos OPCIONAIS definicoes_parametros_adicionais (cidade) e parametros_adicionais (zona). Arquivos 1.1 continuam válidos."
  },
  "municipio": {
   "type": "string"
  },
  "uf": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "codigo_ibge": {
   "type": "string",
   "pattern": "^\\d{7}$"
  },
  "data_levantamento": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "data_atualizacao": {
   "type": [
    "string",
    "null"
   ],
   "description": "(1.2, opcional) Data ISO da última atualização feita pelo editor desktop ou à mão."
  },
  "centro_mapa": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "lat",
    "lon",
    "zoom"
   ],
   "properties": {
    "lat": {
     "type": "number",
     "minimum": -90,
     "maximum": 90
    },
    "lon": {
     "type": "number",
     "minimum": -180,
     "maximum": 180
    },
    "zoom": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20
    }
   }
  },
  "orgao_confirmacao": {
   "type": [
    "string",
    "null"
   ]
  },
  "exemplo_ficticio": {
   "type": "boolean"
  },
  "aviso": {
   "type": [
    "string",
    "null"
   ]
  },
  "marco_legal_vigente": {
   "type": "string"
  },
  "fontes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "titulo",
     "lei",
     "data",
     "url"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/fonte_id"
     },
     "titulo": {
      "type": "string"
     },
     "lei": {
      "type": "string"
     },
     "data": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "arquivo_local": {
      "type": [
       "string",
       "null"
      ]
     },
     "observacao": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "macrozonas": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "codigo",
     "nome",
     "descricao",
     "parametros"
    ],
    "properties": {
     "codigo": {
      "$ref": "#/$defs/codigo"
     },
     "nome": {
      "type": [
       "string",
       "null"
      ]
     },
     "descricao": {
      "type": [
       "string",
       "null"
      ]
     },
     "parametros": {
      "type": "object",
      "propertyNames": {
       "$ref": "#/$defs/chave"
      },
      "additionalProperties": {
       "$ref": "#/$defs/parametro_livre"
      }
     }
    }
   }
  },
  "macrozonas_observacao": {
   "type": [
    "string",
    "null"
   ]
  },
  "zonas": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/zona"
   }
  },
  "definicoes_parametros_adicionais": {
   "type": "array",
   "description": "Catálogo (opcional, 1.2) dos atributos novos da cidade. Cada chave aqui pode aparecer em zonas[].parametros_adicionais, com valor no MESMO formato de parâmetro.",
   "items": {
    "$ref": "#/$defs/definicao_parametro_adicional"
   }
  },
  "camadas_complementares": {
   "type": "object",
   "propertyNames": {
    "$ref": "#/$defs/chave"
   },
   "additionalProperties": {
    "$ref": "#/$defs/camada"
   }
  },
  "outorga_onerosa": {
   "$ref": "#/$defs/bloco"
  },
  "zeis_his": {
   "$ref": "#/$defs/bloco"
  },
  "outros_parametros": {
   "$ref": "#/$defs/bloco"
  },
  "resumo_mcmv": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "geografico": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "descricao",
    "crs",
    "servidor_oficial",
    "camadas",
    "regras_de_consulta",
    "limitacoes"
   ],
   "properties": {
    "descricao": {
     "type": "string"
    },
    "crs": {
     "const": "EPSG:4326"
    },
    "crs_area": {
     "type": "string",
     "pattern": "^EPSG:\\d{4,5}$"
    },
    "servidor_oficial": {
     "type": [
      "string",
      "null"
     ]
    },
    "camadas": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "nome",
       "fonte_url",
       "data_download",
       "oficial",
       "metodo",
       "erro_estimado_m"
      ],
      "anyOf": [
       {
        "required": [
         "arquivo"
        ]
       },
       {
        "required": [
         "campo"
        ]
       }
      ],
      "properties": {
       "nome": {
        "type": "string"
       },
       "arquivo": {
        "type": [
         "string",
         "null"
        ]
       },
       "campo": {
        "type": [
         "string",
         "null"
        ]
       },
       "fonte_url": {
        "type": "string"
       },
       "data_download": {
        "type": "string"
       },
       "oficial": {
        "type": "boolean"
       },
       "metodo": {
        "type": "string"
       },
       "erro_estimado_m": {
        "type": [
         "number",
         "null"
        ]
       },
       "n_feicoes": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       }
      }
     }
    },
    "regras_de_consulta": {
     "type": "string"
    },
    "limitacoes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "raio_divisa_m": {
     "type": "number",
     "minimum": 0
    },
    "pct_minimo_significativo": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "camadas_detalhe": {
     "description": "Anotação livre, NÃO normativa – consumidores devem ignorar."
    },
    "regras_de_consulta_texto": {
     "description": "Anotação livre, NÃO normativa – consumidores devem ignorar."
    },
    "notas_tecnicas": {
     "type": "object",
     "description": "Anotações livres, NÃO normativas (histórico de download etc.)."
    }
   }
  },
  "lacunas": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item",
     "motivo"
    ],
    "properties": {
     "item": {
      "type": "string"
     },
     "motivo": {
      "type": "string"
     }
    }
   }
  },
  "historico_alteracoes": {
   "type": "array",
   "description": "(1.2, opcional) Registro das atualizações da cidade, da mais antiga para a mais nova. Consumidores podem ignorar.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "data",
     "resumo"
    ],
    "properties": {
     "data": {
      "type": "string"
     },
     "resumo": {
      "type": "string",
      "minLength": 1
     },
     "ferramenta": {
      "type": [
       "string",
       "null"
      ]
     },
     "autor": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  }
 },
 "$defs": {
  "codigo": {
   "type": "string",
   "pattern": "^\\S(.*\\S)?$",
   "description": "Código oficial da zona/feição como string, exatamente como na lei/base oficial (sem espaços nas pontas). Ex.: 'Z1', 'ZEIS2', 'AEIS FAVELA'."
  },
  "fonte_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_\\-]+$"
  },
  "chave": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$",
   "description": "snake_case minúsculo sem acento"
  },
  "faixa": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "min",
    "max"
   ],
   "properties": {
    "min": {
     "type": [
      "number",
      "null"
     ]
    },
    "max": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "description": "Intervalo numérico. null = sem limite naquele lado."
  },
  "valor_qualquer": {
   "type": [
    "number",
    "array",
    "null"
   ],
   "items": {
    "type": "string"
   }
  },
  "condicional": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "condicao",
    "forma",
    "valor"
   ],
   "description": "Um caso de um parâmetro que varia por condição (pavimento, IE, macrozona, tipo de lote…). Herda unidade e fonte do parâmetro pai.",
   "properties": {
    "condicao": {
     "type": "string",
     "minLength": 1,
     "description": "Texto curto da condição, ex.: 'térreo e 1º pavimento', 'IE > 2', 'esquina'."
    },
    "codigo": {
     "anyOf": [
      {
       "$ref": "#/$defs/codigo"
      },
      {
       "type": "null"
      }
     ],
     "description": "Se a condição é um código (zona, macrozona, ZA), o código."
    },
    "forma": {
     "enum": [
      "unico",
      "faixa",
      "formula",
      "lista",
      "livre",
      "herda_da_base",
      "nao_aplicavel",
      "sem_dado",
      "texto"
     ]
    },
    "valor": {
     "$ref": "#/$defs/valor_qualquer"
    },
    "faixa": {
     "anyOf": [
      {
       "$ref": "#/$defs/faixa"
      },
      {
       "type": "null"
      }
     ]
    },
    "formula": {
     "type": [
      "string",
      "null"
     ]
    },
    "texto_original": {
     "type": [
      "string",
      "null"
     ]
    },
    "observacao": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "forma": {
        "const": "unico"
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "lista"
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "array"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "faixa"
       }
      }
     },
     "then": {
      "required": [
       "faixa"
      ],
      "properties": {
       "faixa": {
        "$ref": "#/$defs/faixa"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "formula"
       }
      }
     },
     "then": {
      "required": [
       "formula"
      ],
      "properties": {
       "formula": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "texto"
       }
      }
     },
     "then": {
      "required": [
       "texto_original"
      ],
      "properties": {
       "texto_original": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "enum": [
         "faixa",
         "formula",
         "livre",
         "herda_da_base",
         "nao_aplicavel",
         "sem_dado",
         "texto"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "null"
       }
      }
     }
    }
   ]
  },
  "parametro_base": {
   "type": "object",
   "required": [
    "valor",
    "unidade",
    "fonte_id",
    "artigo_anexo",
    "observacao",
    "forma"
   ],
   "properties": {
    "valor": {
     "$ref": "#/$defs/valor_qualquer"
    },
    "unidade": {
     "type": [
      "string",
      "null"
     ]
    },
    "fonte_id": {
     "anyOf": [
      {
       "$ref": "#/$defs/fonte_id"
      },
      {
       "type": "null"
      }
     ]
    },
    "artigo_anexo": {
     "type": [
      "string",
      "null"
     ]
    },
    "observacao": {
     "type": [
      "string",
      "null"
     ]
    },
    "forma": {
     "enum": [
      "unico",
      "faixa",
      "condicional",
      "formula",
      "lista",
      "livre",
      "herda_da_base",
      "nao_aplicavel",
      "sem_dado",
      "texto"
     ]
    },
    "faixa": {
     "anyOf": [
      {
       "$ref": "#/$defs/faixa"
      },
      {
       "type": "null"
      }
     ]
    },
    "condicionais": {
     "anyOf": [
      {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/condicional"
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "formula": {
     "type": [
      "string",
      "null"
     ]
    },
    "texto_original": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "forma": {
        "const": "unico"
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "lista"
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "array"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "faixa"
       }
      }
     },
     "then": {
      "required": [
       "faixa"
      ],
      "properties": {
       "faixa": {
        "$ref": "#/$defs/faixa"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "condicional"
       }
      }
     },
     "then": {
      "required": [
       "condicionais"
      ],
      "properties": {
       "condicionais": {
        "type": "array"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "formula"
       }
      }
     },
     "then": {
      "required": [
       "formula"
      ],
      "properties": {
       "formula": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "texto"
       }
      }
     },
     "then": {
      "required": [
       "texto_original"
      ],
      "properties": {
       "texto_original": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "enum": [
         "faixa",
         "condicional",
         "formula",
         "livre",
         "herda_da_base",
         "nao_aplicavel",
         "sem_dado",
         "texto"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "null"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "not": {
         "const": "sem_dado"
        }
       }
      }
     },
     "then": {
      "properties": {
       "fonte_id": {
        "$ref": "#/$defs/fonte_id"
       }
      }
     },
     "description": "Todo parâmetro com conteúdo (qualquer forma exceto sem_dado) precisa de fonte_id."
    }
   ]
  },
  "parametro_livre": {
   "allOf": [
    {
     "$ref": "#/$defs/parametro_base"
    }
   ],
   "description": "Parâmetro de chave livre (outros, parametros_por_codigo, blocos)."
  },
  "p_coef": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "number",
          "null"
         ]
        },
        "unidade": {
         "const": "coeficiente"
        }
       }
      }
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "p_fracao": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "number",
          "null"
         ],
         "minimum": 0,
         "maximum": 1
        },
        "unidade": {
         "const": "fracao"
        }
       }
      }
     ],
     "description": "Taxas SEMPRE como fração 0–1 (30% → 0.3)."
    },
    {
     "type": "null"
    }
   ]
  },
  "p_metro": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "number",
          "null"
         ],
         "minimum": 0
        },
        "unidade": {
         "const": "m"
        }
       }
      }
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "p_m2": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "number",
          "null"
         ],
         "minimum": 0
        },
        "unidade": {
         "const": "m2"
        }
       }
      }
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "p_pav": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0
        },
        "unidade": {
         "const": "pavimentos"
        }
       }
      }
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "p_dens": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "number",
          "null"
         ]
        },
        "unidade": {
         "enum": [
          "hab/ha",
          "uh/ha",
          null
         ]
        }
       }
      }
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "p_vagas": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
      {
       "properties": {
        "valor": {
         "type": [
          "number",
          "null"
         ]
        },
        "unidade": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     ],
     "description": "unidade livre, ex.: 'vagas/UH', 'vagas/100 m2'"
    },
    {
     "type": "null"
    }
   ]
  },
  "p_usos": {
   "anyOf": [
    {
     "allOf": [
      {
       "$ref": "#/$defs/parametro_base"
      },
