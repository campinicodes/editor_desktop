     "type": [
      "string",
      "null"
     ]
    },
    "texto_original": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "forma": {
        "const": "unico"
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "lista"
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "array"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "faixa"
       }
      }
     },
     "then": {
      "required": [
       "faixa"
      ],
      "properties": {
       "faixa": {
        "$ref": "#/$defs/faixa"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "condicional"
       }
      }
     },
     "then": {
      "required": [
       "condicionais"
      ],
      "properties": {
       "condicionais": {
        "type": "array"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "formula"
       }
      }
     },
     "then": {
      "required": [
       "formula"
      ],
      "properties": {
       "formula": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "const": "texto"
       }
      }
     },
     "then": {
      "required": [
       "texto_original"
      ],
      "properties": {
       "texto_original": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "enum": [
         "faixa",
         "condicional",
         "formula",
         "livre",
         "herda_da_base",
         "nao_aplicavel",
         "sem_dado",
         "texto"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "valor": {
        "type": "null"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "forma": {
        "not": {
         "const": "sem_dado"
        }
       }
      }
     },
     "then": {
      "properties": {
       "fonte_id": {
        "$ref": "#/$defs/fonte_id"
       }
      }
     },
     "description": "Todo parâmetro com conteúdo (qualquer forma exceto sem_dado) precisa de fonte_id."
    }
   ]
